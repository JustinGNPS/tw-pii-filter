# tw-pii-filter 的設定檔範本。
# 第一次執行「啟動.bat」時，若 repo 根目錄沒有 .env，會把這份複製成 .env。
# .env 已被 .gitignore 擋住，不會進 git —— 金鑰只填在 .env，不要填在這份範本裡。
#
# 只想看本機示範頁面（/demo）的話，什麼都不用填：示範頁面不會連到雲端 AI。
# 要讓 AI coding agent（Aider、Cline、Codex…）走 proxy，才需要填下面兩行。

# 雲端 AI 的 OpenAI 相容端點，例如 https://api.openai.com/v1
UPSTREAM_BASE_URL=

# 雲端 AI 的金鑰。agent 那邊填假的（例如 dummy）即可，真金鑰只放在這裡。
UPSTREAM_API_KEY=

# 預設模型
DEFAULT_MODEL=gpt-4.1-mini

# ---- 以下是選填，不懂可以不動 ----

# 組合風險自動降階：off（預設）/ permissive / balanced / strict
# PII_RISK_REDUCTION_POLICY=off

# 偵測到但不遮蔽的型別（預設職稱與公司名不遮）
# PII_SKIP_TYPES=POSITION,COMPANY
